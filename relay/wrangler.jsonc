{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outlook-triage-relay",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "vars": {
    // Requires all migrations through 0007; set false to restore the legacy outbound relay.
    "CLOUD_BOT_ENABLED": "true",
    "NEWS_TRIAL_ENABLED": "true"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outlook-triage-relay",
      "database_id": "84a80db1-a0c6-49fe-8607-1269c59f87c2",
      "migrations_dir": "migrations"
    }
  ]
}
