{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outlook-triage-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outlook-triage-relay",
      "database_id": "84a80db1-a0c6-49fe-8607-1269c59f87c2",
      "migrations_dir": "migrations"
    }
  ]
}
